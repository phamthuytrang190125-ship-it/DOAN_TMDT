        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SequenceAdminQuanLyDonNoAlt\nautonumber\nactor \&quot;Quản trị viên\&quot; as Admin\nparticipant \&quot;FrmQuanLyDon\&quot; as FrmAdmin\nparticipant \&quot;OrderService\&quot; as OrderService\ndatabase \&quot;SQL Server\&quot; as SQLServer\n\nAdmin -&gt; FrmAdmin : 1. Truy cập danh sách đơn thuê\nactivate FrmAdmin\n\nFrmAdmin -&gt; OrderService : 2. LayDanhSachDonThue()\nactivate OrderService\n\nOrderService -&gt; SQLServer : 3. SELECT * FROM RentalOrders\nactivate SQLServer\nSQLServer --&gt; OrderService : 4. Trả về danh sách đơn hàng\ndeactivate SQLServer\n\nOrderService --&gt; FrmAdmin : 5. Hiển thị danh sách đơn lên Bảng Quản lý\ndeactivate OrderService\n\nAdmin -&gt; FrmAdmin : 6. Chọn đơn hàng &amp; Đổi trạng thái (PENDING -&gt; CONFIRMED / RENTING / COMPLETED)\n\nFrmAdmin -&gt; OrderService : 7. CapNhatTrangThaiDon(MaDon, TrangThaiMoi)\nactivate OrderService\n\nOrderService -&gt; SQLServer : 8. UPDATE RentalOrders SET Status = TrangThaiMoi WHERE ID = MaDon\nactivate SQLServer\nSQLServer --&gt; OrderService : 9. Cập nhật CSDL thành công\ndeactivate SQLServer\n\nOrderService --&gt; FrmAdmin : 10. Trả về kết quả cập nhật thành công\nFrmAdmin --&gt; Admin : 11. Hiển thị thông báo \&quot;Cập nhật trạng thái thành công\&quot; &amp; Refresh Bảng\n\ndeactivate OrderService\ndeactivate FrmAdmin\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fBUJryF5kgBGy3RVgLbR-1">
